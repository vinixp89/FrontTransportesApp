# Usado automaticamente por "npm run build" (modo production) — sobrescreve o .env local.
# É só a URL pública da API, não é segredo, então pode ficar no Git: evita publicar um build
# sem endereço da API quando o .env da máquina que gerou o build está ausente ou aponta pra localhost.
VITE_API_URL=https://api.vainaboamobilidade.com.br/api
